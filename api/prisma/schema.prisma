// Wolf Car showroom ordering — database schema.
//
// Constraints Prisma cannot express (partial unique indexes, CHECKs, deferred
// constraint triggers, the append-only activity log) live in hand-written SQL
// at the end of the first migration. See README → "Database constraints".

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  FINANCE
  BRANCH_MANAGER
  CASHIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PermissionEffect {
  GRANT
  REVOKE
}

enum SessionAudience {
  DASHBOARD
  SHOWROOM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  /// Short uppercase code used as the order-number prefix, e.g. "GH".
  code      String   @unique @db.VarChar(4)
  name      String   @db.VarChar(120)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  /// Per-branch order counter, incremented inside the order transaction.
  orderSeq  Int      @default(0) @map("order_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    User[]
  products BranchProduct[]
  orders   Order[]

  @@map("branches")
}

model User {
  id                        String    @id @default(uuid()) @db.Uuid
  username                  String    @unique @db.VarChar(40)
  displayName               String    @map("display_name") @db.VarChar(120)
  email                     String?   @unique @db.VarChar(254)
  role                      Role
  branchId                  String?   @map("branch_id") @db.Uuid
  passwordHash              String    @map("password_hash")
  showroomPasswordHash      String?   @map("showroom_password_hash")
  isActive                  Boolean   @default(true) @map("is_active")
  deletedAt                 DateTime? @map("deleted_at") @db.Timestamptz(3)
  failedLoginCount          Int       @default(0) @map("failed_login_count")
  lockedUntil               DateTime? @map("locked_until") @db.Timestamptz(3)
  showroomFailedCount       Int       @default(0) @map("showroom_failed_count")
  showroomLockedUntil       DateTime? @map("showroom_locked_until") @db.Timestamptz(3)
  twoFactorEnabled          Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc        String?   @map("two_factor_secret_enc")
  twoFactorPendingSecretEnc String?   @map("two_factor_pending_secret_enc")
  /// Last accepted TOTP time step; codes from this step or earlier are rejected (replay protection).
  twoFactorLastStep         Int?      @map("two_factor_last_step")
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdById               String?   @map("created_by_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy           User?                    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers        User[]                   @relation("UserCreatedBy")
  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  permissionOverrides UserPermissionOverride[] @relation("OverrideUser")
  grantedOverrides    UserPermissionOverride[] @relation("OverrideGrantedBy")
  productsCreated     Product[]                @relation("ProductCreatedBy")
  productsUpdated     Product[]                @relation("ProductUpdatedBy")
  priceChanges        PriceHistory[]
  ordersCreated       Order[]                  @relation("OrderCreatedBy")
  ordersConfirmed     Order[]                  @relation("OrderConfirmedBy")
  ordersCancelled     Order[]                  @relation("OrderCancelledBy")

  @@index([branchId])
  @@index([role])
  @@map("users")
}

model Permission {
  key         String @id @db.VarChar(64)
  group       String @db.VarChar(32)
  description String @db.VarChar(255)

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  role          Role
  permissionKey String   @map("permission_key") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId        String           @map("user_id") @db.Uuid
  permissionKey String           @map("permission_key") @db.VarChar(64)
  effect        PermissionEffect
  grantedById   String?          @map("granted_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation("OverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("OverrideGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([userId, permissionKey])
  @@map("user_permission_overrides")
}

model Session {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  audience   SessionAudience
  /// Absolute expiry; refresh rotation never extends past it.
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?       @map("revoke_reason") @db.VarChar(40)
  lastUsedAt DateTime        @default(now()) @map("last_used_at") @db.Timestamptz(3)
  ip         String?         @db.VarChar(64)
  userAgent  String?         @map("user_agent") @db.VarChar(512)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token is rotated. Presenting a used token revokes the whole session (reuse detection).
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Catalogue grouping shown as the showroom tabs — usually a car model
/// ("ﻟﻴﻮﺑﺎرد 5"), sometimes an accessory line ("اكسسوارات تسلا").
model Category {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @db.VarChar(120)
  /// English name for the public website's /en pages; `name` (Arabic) when null.
  nameEn String? @map("name_en") @db.VarChar(120)
  /// The car this grouping is for, as printed on the showroom header.
  carModel String? @map("car_model") @db.VarChar(120)
  /// UUID of the processed hero image in UPLOAD_DIR, as for Product.imageKey.
  imageKey String? @map("image_key") @db.Uuid
  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")
  /// Primary key from the legacy Supabase catalogue ("cat-1787146025137"), so
  /// re-running the import updates rows instead of duplicating them.
  legacyId  String?  @unique @map("legacy_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([position])
  @@map("categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(120)
  description    String?   @db.VarChar(2000)
  /// NOT unique: the legacy catalogue lists the same part once per car model,
  /// so 147 barcodes are shared by several products. Cashiers scan the code
  /// into their own counting system, where it identifies the part, not the row.
  barcode        String?   @db.VarChar(64)
  categoryId     String?   @map("category_id") @db.Uuid
  /// Primary key from the legacy Supabase catalogue ("prod-1787146069197").
  legacyId       String?   @unique @map("legacy_id") @db.VarChar(64)
  /// UUID of the processed image files in UPLOAD_DIR (<key>.webp and <key>-sm.webp).
  imageKey       String    @map("image_key") @db.Uuid
  /// Null until Finance sets it. Unpriced products are hidden from the showroom.
  price          Decimal?  @db.Decimal(12, 2)
  priceUpdatedAt DateTime? @map("price_updated_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy       User            @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchPositions BranchProduct[]
  priceHistory    PriceHistory[]
  orderItems      OrderItem[]

  @@index([name])
  @@index([barcode])
  @@index([categoryId])
  @@map("products")
}

/// Per-branch showroom display order of the (global) catalog.
model BranchProduct {
  branchId  String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  position  Int

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  /// Re-created as a DEFERRABLE constraint in SQL so a reorder can swap positions in one statement.
  @@unique([branchId, position], map: "branch_products_branch_id_position_key")
  @@map("branch_products")
}

model PriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  oldPrice    Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  changedById String   @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([productId, changedAt])
  @@map("price_history")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  /// Per-branch sequence number; `code` is "<branch code>-<number padded to 6>".
  number         Int
  code           String      @unique @db.VarChar(16)
  customerName   String      @map("customer_name") @db.VarChar(80)
  status         OrderStatus @default(PENDING)
  total          Decimal     @db.Decimal(12, 2)
  currency       String      @default("QAR") @db.Char(3)
  createdById    String      @map("created_by_id") @db.Uuid
  confirmedById  String?     @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  cancelledById  String?     @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey String?     @map("idempotency_key") @db.VarChar(80)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User?       @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy User?       @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items       OrderItem[]

  @@unique([branchId, number])
  @@unique([createdById, idempotencyKey])
  @@index([branchId, status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  /// Snapshots taken at order time, so later renames or price changes never alter the order.
  productName String  @map("product_name") @db.VarChar(120)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  position    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@map("order_items")
}

/// Append-only audit trail (UPDATE/DELETE are blocked by a trigger).
/// Deliberately has no foreign keys: entries must outlive whatever they describe.
model ActivityLog {
  id            BigInt       @id @default(autoincrement())
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId       String?      @map("actor_id") @db.Uuid
  actorUsername String?      @map("actor_username") @db.VarChar(40)
  actorRole     Role?        @map("actor_role")
  branchId      String?      @map("branch_id") @db.Uuid
  action        String       @db.VarChar(64)
  entityType    String?      @map("entity_type") @db.VarChar(32)
  entityId      String?      @map("entity_id") @db.VarChar(64)
  before        Json?
  after         Json?
  metadata      Json?
  outcome       AuditOutcome
  ip            String?      @db.VarChar(64)
  userAgent     String?      @map("user_agent") @db.VarChar(512)
  requestId     String?      @map("request_id") @db.VarChar(64)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
