# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed by CORS (the Next.js app).
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy" setting; the Next.js rewrite proxy runs on loopback.
TRUST_PROXY=loopback
SWAGGER_ENABLED=true

# ---- database --------------------------------------------------------------
DATABASE_URL=postgresql://wolfcar:wolfcar@localhost:5432/wolfcar
# Used only by the e2e test suite (it is wiped on every run).
TEST_DATABASE_URL=postgresql://wolfcar:wolfcar@localhost:5433/wolfcar_test

# ---- auth ------------------------------------------------------------------
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
SHOWROOM_SESSION_TTL_HOURS=16
# Secure cookies are sent over http://localhost by Chromium and Firefox; keep true.
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Requests per window per IP on the auth endpoints.
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# ---- two-factor ------------------------------------------------------------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64=
TOTP_ISSUER=Wolf Car

# ---- files -----------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
# Leave empty to use Puppeteer's bundled Chrome; set in Docker (/usr/bin/chromium).
CHROME_PATH=
